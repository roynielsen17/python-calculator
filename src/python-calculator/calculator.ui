  <widget class="QWidget" name="centralwidget">
   <property name="styleSheet">
    <string notr="true">/* Base Style: All Buttons &amp; Numbers */
QPushButton {
    background-color: #1a162b;
    color: #ffffff;                             /* Crisp bright white text */
    font-family: &quot;Segoe UI&quot;, &quot;Consolas&quot;, sans-serif;
    font-size: 30px;                            /* Bigger, bolder text */
    font-weight: 700;                           /* Extra bold weight */
    border: 1px solid #2d2644;
    border-radius: 12px;
}

/* Hover Effect: Text Glows Light Cyan */
QPushButton:hover {
    background-color: #26203e;
    border: 1px solid #00f2fe;
    color: #00f2fe;                             /* Text lights up on hover! */
}

QPushButton:pressed {
    background-color: #120e20;
    color: #ffffff;
}

/* -------------------------------------------------- */
/* SPECIAL NEON GLOWS FOR TEXT &amp; BORDERS              */
/* -------------------------------------------------- */

/* Top Function Keys (C, (), .) */
#btn_clear, #btn_bracket, #btn_dot {
    background-color: rgba(0, 242, 254, 0.08);
    color: #00f2fe;                             /* Neon Cyan Text */
    font-size: 30px;
    font-weight: 800;
    border: 1px solid rgba(0, 242, 254, 0.4);
}

#btn_clear:hover, #btn_bracket:hover, #btn_dot:hover {
    background-color: rgba(0, 242, 254, 0.25);
    border: 1px solid #00f2fe;
    color: #ffffff;
}

/* Operator Keys (÷, ×, -, +) */
#btn_div, #btn_mul, #btn_sub, #btn_add {
    background-color: rgba(225, 0, 255, 0.08);
    color: #ff007f;                             /* Neon Magenta Text */
    font-size: 30px;                            /* Slightly larger for operator symbols */
    font-weight: 800;
    border: 1px solid rgba(225, 0, 255, 0.4);
}

#btn_div:hover, #btn_mul:hover, #btn_sub:hover, #btn_add:hover {
    background-color: rgba(225, 0, 255, 0.25);
    border: 1px solid #ff007f;
    color: #ffffff;
}

/* Equals Key (=) */
#btn_equal {
    background: qlineargradient(
        spread:pad, x1:0, y1:0, x2:1, y2:0, 
        stop:0 #00f2fe, 
        stop:1 #ff007f
    );
    color: #ffffff;
    font-size: 30px;
    font-weight: 900;
    border: none;
}</string>
